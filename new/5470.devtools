":null,"created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[{"id":1,"type_id":2,"key":"plugin","data_type":"text","description":"Name of the plugin from where the inventory comes from. It is advisable to specify the plugin name to avoid opening another inventory with the same name.","documentation_url":"https:\/\/docs.zmenu.dev\/configurations\/buttons#inventory","created_at":"2024-02-26T18:14:36.000000Z","updated_at":"2024-02-26T18:14:36.000000Z"},{"id":2,"type_id":2,"key":"inventory","data_type":"text","description":"Name of the inventory you want to open. The name of the inventory will be the name of the inventory file.","documentation_url":"https:\/\/docs.zmenu.dev\/configurations\/buttons#inventory","created_at":"2024-02-26T18:14:36.000000Z","updated_at":"2024-02-26T18:14:36.000000Z"},{"id":3,"type_id":2,"key":"toPage","data_type":"number","description":"Number of the page you want to open. Default will be 1.","documentation_url":"https:\/\/docs.zmenu.dev\/configurations\/buttons#inventory","created_at":"2024-02-26T18:14:36.000000Z","updated_at":"2024-02-26T18:14:36.000000Z"},{"id":4,"type_id":2,"key":"arguments","data_type":"textarea","description":"List of arguments you can add. An argument can contain a name in the following format: <name>:<value>","documentation_url":"https:\/\/docs.zmenu.dev\/configurations\/buttons#inventory","created_at":"2024-02-26T18:14:36.000000Z","updated_at":"2024-02-26T18:14:36.000000Z"}]},{"id":3,"addon_id":1,"name":"Back","description":"Allows you to return to the previous inventory.","example":null,"created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[]},{"id":4,"addon_id":1,"name":"Home","description":"Allows you to return to the main inventory, the one that was opened first.","example":null,"created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[]},{"id":5,"addon_id":1,"name":"Next","description":"Allows you to go to the next page if it exists. You can use the else element to display another button if there is no next page.","example":"next:\n  type: NEXT\n  isPermanent: true\n  slot: 50\n  item:\n    material: ARROW\n    name: '&fNext'\n  else: #Displays another button if there is no next page.\n    slot: 50\n    type: NONE\n    isPermanent: true\n    item:\n      material: BLACK_STAINED_GLASS_PANE","created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[]},{"id":6,"addon_id":1,"name":"Previous","description":"Allows you to go to the previous page if it exists. You can use the else element to display another button if there is no previous page.","example":"next:\n  type: PREVIOUS\n  isPermanent: true\n  slot: 50\n  item:\n    material: ARROW\n    name: '&fPrevious'\n  else: #Displays another button if there is no next page.\n    slot: 50\n    type: NONE\n    isPermanent: true\n    item:\n      material: BLACK_STAINED_GLASS_PANE","created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[]},{"id":7,"addon_id":1,"name":"MainMenu","description":"Allows you to returns to the main inventory you chose in the config.json","example":null,"created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[]},{"id":8,"addon_id":1,"name":"Jump","description":"Allows to change page, to a predefined page.","example":null,"created_at":"2024-02-13T11:54:21.000000Z","updated_at":"2024-02-13T11:54:21.000000Z","contents":[{"id":5,"type_id":8,"key":"toPage","data_type":"number","description":null,"documentation_url":"https:\/\/docs.zmenu.dev\/configurations\/buttons#jump","created_at":"2024-02-26T18:14:36.000000Z","updated_at":"2024-02-26T18:14:36.000000Z"}]}],"sounds":[],"actions":[{"id":1,"addon_id":1,"name":"player command","description":"Executes commands as the player. You can also send the command in the player's chat.","example":null,"documentation_url":"https: